# ══════════════════════════════════════════════════════════════════════
# Microstock Metadata Management Tool — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — it is listed in .gitignore.
# ══════════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Supabase Database ─────────────────────────────────────────────────
# Get these from: https://app.supabase.com → Your Project → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── JWT Authentication ────────────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=replace-with-a-minimum-32-character-random-string
JWT_EXPIRES_IN=7d

# ── CORS (set to your Netlify site URL in production) ─────────────────
ALLOWED_ORIGIN=http://localhost:3000

# ── BYOK Notice ───────────────────────────────────────────────────────
# Gemini API keys are NOT stored here — users supply their own per-session.
